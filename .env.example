# Session secret for admin authentication (change in production!)
SESSION_SECRET=dev-session-secret-change-me

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Agent token for print agent authentication
AGENT_TOKEN=dev-agent-token-change-me

# Database path (relative to project root)
DATABASE_PATH=data/selfprint.sqlite

# Upload directories
UPLOAD_DIR=uploads

# Max upload size in MB
MAX_UPLOAD_MB=25