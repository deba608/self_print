# Required: shared secret. Seeded into agent_tokens; in dev it also protects
# /api/cleanup when CRON_SECRET is unset. (The print agent itself authenticates
# to Supabase with the service-role key in agent/config.json.)
AGENT_TOKEN=change-me-to-a-random-secret

# Optional: Supabase (for production deployment)
# Leave empty to use local SQLite for development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Supabase Auth (staff + customer accounts).
# Same Supabase project as SUPABASE_URL — these are the browser-safe versions.
# The anon key is safe to expose in the browser (RLS-protected); SUPABASE_SERVICE_ROLE_KEY must never be exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended in production: canonical base URL for confirmation, password
# recovery, and staff invitation emails. On Vercel the app also falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL; locally it uses localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional: UPI Payment (shows QR + pay button on customer token screen)
# Leave empty to hide UPI payment and show "pay at counter" message instead
#
# For a PERSONAL UPI ID (GPay/PhonePe/Paytm), set SHOP_UPI_ID only:
SHOP_UPI_ID=yourshop@upi
SHOP_NAME=My Print Shop
#
# For a MERCHANT / aggregator sticker (GetePay, BharatPe, Paytm for Business, etc.):
# a rebuilt link is rejected because it drops the sticker's signed params.
# Decode the printed sticker QR and paste its FULL raw string here instead.
# When set, this takes priority over SHOP_UPI_ID; the app injects only the amount.
# Example: SHOP_UPI_QR=upi://pay?pa=Getepay.ucbqrapp518905@icici&pn=Shop&mc=8931&mode=02
SHOP_UPI_QR=

# Optional: Razorpay Standard Checkout (auto-confirms payment, marks job paid)
# When RAZORPAY_KEY_ID is set, the token screen shows a Razorpay "Pay" button
# instead of the UPI QR. Get keys from Razorpay Dashboard > Settings > API Keys.
# Use rzp_test_* while testing; swap to rzp_live_* after KYC (no code change).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook backup: create a webhook (event: payment.captured) at
# <your-site>/api/payments/webhook and paste its secret here. Leave empty to
# rely on client-side verification only.
RAZORPAY_WEBHOOK_SECRET=

# Optional: Google review link (shows a "Rate us on Google" button once an
# order is fully complete — printed for pickup, delivered for delivery orders)
# Leave empty to hide the button entirely.
# Get this from Google Business Profile > "Ask for reviews" > copy link
# (looks like https://g.page/r/XXXXXXXX/review), or build one from your
# listing's CID: https://search.google.com/local/writereview?placeid=<CID>
SHOP_REVIEW_URL=

# Optional: Cron job protection (required in production)
CRON_SECRET=
